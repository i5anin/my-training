# Телеграм-бот сводок. Скопировать в server/.env и заполнить.
# .env в git не попадает — держать значения только там.

TELEGRAM_ENABLED=true

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Свой chat_id: запустить бота и отправить ему /id
TELEGRAM_OWNER_CHAT_ID=

# Свой Bot API server вместо api.telegram.org (необязательно)
TELEGRAM_API_ROOT=

# off — бот только отправляет (никакого getUpdates);
# polling — ещё и отвечает на команды /today /last /week и кнопки
TELEGRAM_UPDATES=off

TELEGRAM_TZ=Europe/Moscow

# Вечерняя сводка и догоняющая проверка
TELEGRAM_DIGEST_CRON=0 21 * * *
TELEGRAM_CATCHUP_CRON=*/30 18-23 * * *

# silent — молчать в день без тренировки, notify — присылать напоминание
TELEGRAM_EMPTY_DAY=silent

# false — не использовать sendRichMessage, только MarkdownV2
TELEGRAM_RICH=true

# false — не отправлять фото и видео тренировки
TELEGRAM_MEDIA=true

# Ссылка на веб-клиент для кнопки «Открыть в приложении»
TELEGRAM_APP_URL=http://localhost:4173

# Премиум-эмодзи: {"dumbbell":"5368324170671202286","up":"..."}
# Работают, только если у владельца бота есть Telegram Premium
TELEGRAM_EMOJI_MAP=
